generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}
enum UserRole {
  PLATFORM_ADMIN
  INSTITUTION_ADMIN
  EDUCATOR
}

enum DocumentType {
  STUDY_GUIDE
  TEXTBOOK
  MODULE_GUIDE
  OTHER
}

enum DocumentStatus {
  PENDING
  UPLOADED
  PROCESSING
  READY
  FAILED
}

model User {
  id            String    @id @default(uuid())
  supabaseId    String    @unique @map("supabase_id")
  email         String    @unique
  fullName      String?   @map("full_name")
  role          UserRole  @default(EDUCATOR)
  isActive      Boolean   @default(true) @map("is_active")
  institutionId String?   @map("institution_id")
  institution   Institution? @relation(fields: [institutionId], references: [id])
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  documents     Document[]
  assessments Assessment[]
  bankQuestions BankQuestion[]
  subscription Subscription?

  @@map("users")
}

model Document {
  id            String         @id @default(uuid())
  ownerId       String         @map("owner_id")
  owner         User           @relation(fields: [ownerId], references: [id])
  fileName      String         @map("file_name")
  fileType      String         @map("file_type")
  fileSizeBytes Int            @map("file_size_bytes")
  storagePath   String         @map("storage_path")
  documentType  DocumentType   @map("document_type")
  status        DocumentStatus @default(PENDING)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  processingError String? @map("processing_error")
  chunks DocumentChunk[]
  assessmentLinks AssessmentDocument[]

  @@map("documents")
}

model DocumentChunk {
  id         String  @id @default(uuid())
  documentId String  @map("document_id")
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String
  embedding  Unsupported("vector(1536)")?
  chunkIndex Int     @map("chunk_index")
  pageNumber Int?    @map("page_number")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("document_chunks")
}

// ── Assessment Configuration Enums ─────────────────────────────────
// South African higher-education NQF levels this platform targets.
enum NqfLevel {
  LEVEL_5
  LEVEL_6
  LEVEL_7
  LEVEL_8
  LEVEL_9
  LEVEL_10
}

// The overall category of assessment being generated.
enum AssessmentType {
  TEST
  EXAM
  ASSIGNMENT
  QUIZ
}

// Every question type the platform can generate, including the new
// scenario-based type — these require the AI to construct a realistic
// situation grounded in source material and pose an applied-reasoning question.
enum QuestionType {
  MCQ
  SHORT_ANSWER
  ESSAY
  TRUE_FALSE
  SCENARIO_BASED
}

// Lifecycle status of an Assessment record. DRAFT = wizard in progress/saved,
// GENERATING/GENERATED/FAILED are used once Phase 8 generation kicks in.
enum AssessmentStatus {
  DRAFT
  GENERATING
  GENERATED
  FAILED
}

// ── Assessment Configuration Models ────────────────────────────────

model Assessment {
  id                     String           @id @default(uuid())
  ownerId                String           @map("owner_id")
  owner                  User             @relation(fields: [ownerId], references: [id])

  // Step 2: Assessment Basics — nullable because drafts start empty and get
  // filled in progressively as the educator completes each wizard step.
  title                  String?
  moduleName             String?          @map("module_name")
  nqfLevel               NqfLevel?        @map("nqf_level")
  assessmentType         AssessmentType?  @map("assessment_type")
  totalDurationMinutes   Int?             @map("total_duration_minutes")
  totalMarks             Int?             @map("total_marks")

  // Step 4: Academic Rigor — stored as simple percentage maps, e.g.
  // { "REMEMBER": 10, "UNDERSTAND": 20, "APPLY": 30, "ANALYZE": 20, "EVALUATE": 10, "CREATE": 10 }
  // Kept as Json rather than separate tables since these are just percentage
  // breakdowns read/written as a whole unit — no need to query into them individually.
  // Also nullable until the educator reaches Step 4.
  bloomsDistribution     Json?            @map("blooms_distribution")
  difficultyDistribution Json?            @map("difficulty_distribution")
  status                 AssessmentStatus @default(DRAFT)
  createdAt              DateTime         @default(now()) @map("created_at")
  updatedAt              DateTime         @updatedAt @map("updated_at")
  // Step 1: selected source documents (many-to-many via join table)
  sourceDocuments        AssessmentDocument[]

  // Step 3: question type breakdown (one row per selected type)
  questionTypeConfigs    AssessmentQuestionTypeConfig[]

  learningOutcomes       LearningOutcome[]
  questions        Question[]

  @@map("assessments")
}

// Join table linking an Assessment to the Documents chosen as source
// material in Step 1 of the wizard. Many-to-many: one assessment can draw
// from multiple documents, and a document can be reused across assessments.
model AssessmentDocument {
  id           String     @id @default(uuid())
  assessmentId String     @map("assessment_id")
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  documentId   String     @map("document_id")
  document     Document   @relation(fields: [documentId], references: [id])
  createdAt    DateTime   @default(now()) @map("created_at")

  // Prevents the same document being linked twice to the same assessment.
  @@unique([assessmentId, documentId])
  @@map("assessment_documents")
}

// One row per question type the educator configured in Step 3, e.g.
// { questionType: MCQ, questionCount: 10, marksPerQuestion: 2 }
// { questionType: SCENARIO_BASED, questionCount: 3, marksPerQuestion: 10 }
model AssessmentQuestionTypeConfig {
  id               String       @id @default(uuid())
  assessmentId     String       @map("assessment_id")
  assessment       Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  
 questionType     QuestionType @map("question_type")
  questionCount    Int        @map("question_count")
  marksPerQuestion Int        @map("marks_per_question")

  // Tracks Phase 8 generation progress for THIS question type's batch.
  // Generation is batched per config (one AI call generates all
  // questionCount questions of this type together), so each type can
  // succeed or fail independently of the others.
  generationStatus GenerationStatus @default(PENDING) @map("generation_status")
  generationError  String?          @map("generation_error")
  questions        Question[]

  // Prevents configuring the same question type twice for one assessment.
  @@unique([assessmentId, questionType])
  @@map("assessment_question_type_configs")
}

// Structured learning outcomes for an Assessment, captured in Step 2 of the
// wizard. Each outcome gets a stable code (LO1, LO2, ...) scoped to its
// assessment, so Phase 8's Question model can reference individual outcomes
// via a real foreign key — enabling question-to-outcome mapping and, later,
// validation that Bloom's-level targeting actually matches outcome verbs.
model LearningOutcome {
  id           String     @id @default(uuid())
  assessmentId String     @map("assessment_id")
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  code         String     // e.g. "LO1", "LO2" — human-readable, scoped per assessment
  description  String     // the actual outcome statement, e.g. "Explain the ethical implications of..."
  orderIndex   Int        @map("order_index") // preserves the order educator entered them in

  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  
  questionLinks QuestionLearningOutcome[]

  // Prevents duplicate codes within the same assessment (e.g. two "LO1"s).
  @@unique([assessmentId, code])
  @@map("learning_outcomes")
}

// ── Question Generation Enums ──────────────────────────────────────
// Matches the keys used in Assessment.bloomsDistribution /
// difficultyDistribution JSON maps, but as a proper enum here since
// each generated Question is tagged with a single concrete value,
// not a percentage distribution.
enum BloomsLevel {
  REMEMBER
  UNDERSTAND
  APPLY
  ANALYZE
  EVALUATE
  CREATE
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

// Tracks generation progress per question-type batch, since generation
// is batched per AssessmentQuestionTypeConfig (one AI call per type),
// not per individual question or per whole assessment.
enum GenerationStatus {
  PENDING
  GENERATING
  GENERATED
  FAILED
}

// ── Question Generation Models ─────────────────────────────────────

model Question {
  id                 String       @id @default(uuid())
  assessmentId       String       @map("assessment_id")
  assessment         Assessment   @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  // Which Step 3 config this question was generated for -- links back
  // to the question type, and lets us regenerate/retry a single batch
  // without touching questions from other types.
  questionTypeConfigId String     @map("question_type_config_id")
  questionTypeConfig  AssessmentQuestionTypeConfig @relation(fields: [questionTypeConfigId], references: [id], onDelete: Cascade)

  questionText       String       @map("question_text")
  marks              Int

  // Tagged per-question so the ACTUAL generated distribution can later
  // be compared against the TARGET distribution set in Step 4.
  bloomsLevel        BloomsLevel  @map("blooms_level")
  difficulty         DifficultyLevel

  // Type-specific structured content, e.g. MCQ options as
  // [{ "label": "A", "text": "...", "isCorrect": true }, ...].
  // Kept as Json since the shape genuinely varies by question type
  // (MCQ needs options, true/false needs a boolean, essay/scenario
  // need neither) -- a single flexible field is simpler than several
  // mostly-null type-specific columns.
  optionsData        Json?        @map("options_data")

  // The memorandum / marking guide, generated alongside the question
  // itself so it stays coherent with the exact question phrasing and
  // retrieved source context. For MCQ/true-false this may just restate
  // the correct answer; for essay/scenario it's a fuller marking rubric.
  memorandum         String

  orderIndex         Int          @map("order_index")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  learningOutcomeLinks QuestionLearningOutcome[]

  @@map("questions")
}

// Join table: which learning outcome(s) each question targets.
// Many-to-many, since a single question can reasonably address more
// than one stated outcome (e.g. a scenario question that both explains
// AND critically evaluates).
model QuestionLearningOutcome {
  id                String          @id @default(uuid())
  questionId        String          @map("question_id")
  question          Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  learningOutcomeId String          @map("learning_outcome_id")
  learningOutcome   LearningOutcome @relation(fields: [learningOutcomeId], references: [id], onDelete: Cascade)

  @@unique([questionId, learningOutcomeId])
  @@map("question_learning_outcomes")
}

enum BankQuestionSource {
  SAVED_FROM_ASSESSMENT
  MANUALLY_CREATED
}

model BankQuestion {
  id              String           @id @default(uuid())
  ownerId         String           @map("owner_id")
  owner           User             @relation(fields: [ownerId], references: [id])

  questionText    String           @map("question_text")
  marks           Int
  questionType    QuestionType     @map("question_type")
  bloomsLevel     BloomsLevel      @map("blooms_level")
  difficulty      DifficultyLevel

  optionsData     Json?            @map("options_data")
  memorandum      String

  source          BankQuestionSource @default(SAVED_FROM_ASSESSMENT) @map("source")

  // Optional provenance: which assessment/question this was copied from,
  // for reference only -- NOT a live link. If the original assessment or
  // question is later deleted, this just becomes null (no cascade needed
  // since it's purely informational, not a functional dependency).
  sourceAssessmentTitle String?    @map("source_assessment_title")

  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@map("bank_questions")
}

model Institution {
  id        String   @id @default(uuid())
  name      String
  domain    String?  @unique @map("domain") // e.g. "university.ac.za", optional -- useful later for auto-assigning users by email domain, not required now
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users     User[]

  @@map("institutions")
}

enum SubscriptionPlan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
}

model Subscription {
  id                    String             @id @default(uuid())
  userId                String             @unique @map("user_id")
  user                  User               @relation(fields: [userId], references: [id])

  plan                  SubscriptionPlan   @default(FREE)
  status                SubscriptionStatus @default(ACTIVE)

  // PayFast-specific references, used to manage/verify the subscription
  // via their API and to match incoming ITN webhook notifications back
  // to the correct user. Nullable since a FREE-plan user has never
  // actually gone through PayFast at all.
  payfastToken          String?            @map("payfast_token")
  payfastSubscriptionId String?            @map("payfast_subscription_id")

  currentPeriodEnd      DateTime?          @map("current_period_end")

  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  @@map("subscriptions")
}