{
  "name": "ai-assessment-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "npm run generate --workspace=apps/api",
    "redis:up": "docker compose -f infra/docker-compose.yml up -d",
    "redis:down": "docker compose -f infra/docker-compose.yml down",
    "redis:logs": "docker compose -f infra/docker-compose.yml logs -f redis"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}